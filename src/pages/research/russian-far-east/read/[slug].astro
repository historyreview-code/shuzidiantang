---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import reading from '../../../../data/russian-far-east-reading.json';
const data = reading as any;
export function getStaticPaths() {
  const pages = (reading as any).pages as any[];
  return pages.map((page: any) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as any;
---
<BaseLayout current="research" title={`${page.title} · 在线阅读 · 俄罗斯远东的形成与变迁`} description={`《俄罗斯远东的形成与变迁》v1.4 在线阅读：${page.label}。劳伦斯著。`} image="/research/russian-far-east/v1-4/cover.jpg">
  <main class="page reading-page">
    <nav class="read-crumb" aria-label="阅读导航">
      <a href="/research/russian-far-east/">← 书籍页</a>
      <a href="/research/russian-far-east/read/">在线阅读目录</a>
      <span>{page.kicker}</span>
    </nav>
    <article class="read-article">
      <header class="read-head">
        <p class="read-kicker">{page.kicker}</p>
        <h1>{page.title}</h1>
        <p class="read-sub">《俄罗斯远东的形成与变迁》· 劳伦斯 · v1.4</p>
      </header>
      <div class="read-body" set:html={page.html} />
    </article>
    <nav class="read-pager" aria-label="前后篇">
      {page.prev ? <a class="prev" href={`/research/russian-far-east/read/${page.prev_slug}/`}><span>上一页</span>{page.prev}</a> : <span></span>}
      {page.next ? <a class="next" href={`/research/russian-far-east/read/${page.next_slug}/`}><span>下一页</span>{page.next}</a> : <span></span>}
    </nav>
    <p class="read-foot"><a href="/research/russian-far-east/read/">全书目录</a><span>·</span><a href="/research/russian-far-east/v1-4/russian-far-east-lawrence-v1.4.epub" download>下载 EPUB v1.4</a><span>·</span><a href="/research/russian-far-east/">返回书籍页</a></p>
  </main>
</BaseLayout>
<style>
  .reading-page{max-width:820px;margin:0 auto;padding:28px 24px 70px}
  .read-crumb{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:baseline;font:11px var(--mono);color:var(--ink-3);margin-bottom:28px}
  .read-crumb a{color:var(--ink-2);text-decoration:none}
  .read-crumb a:hover{color:var(--amber)}
  .read-crumb span{margin-left:auto}
  .read-head{border-bottom:1px solid var(--line);padding-bottom:22px;margin-bottom:30px}
  .read-kicker{font:11px var(--mono);letter-spacing:.22em;color:var(--amber);margin:0 0 12px}
  .read-head h1{font:600 clamp(26px,3.6vw,38px)/1.5 var(--serif);margin:0 0 10px}
  .read-sub{font:13px/1.8 var(--serif);color:var(--ink-3);margin:0}
  .read-body{font:17px/2.05 var(--serif);color:var(--ink)}
  .read-body :global(p){margin:1.05em 0;text-align:justify;text-indent:2em}
  .read-body :global(h2){font:500 23px/1.6 var(--serif);margin:2.2em 0 .7em;padding-bottom:.25em;border-bottom:1px solid var(--line);text-indent:0}
  .read-body :global(h2.plate-title){border:0;text-align:center;font-size:20px;margin-top:2.6em;color:var(--ink-2)}
  .read-body :global(figure){margin:2em 0;text-align:center}
  .read-body :global(figure img){display:block;width:100%;height:auto;margin:0 auto;border:1px solid var(--line);background:#faf8f2}
  .read-body :global(figcaption){font:12px/1.85 var(--serif);color:var(--ink-2);text-align:left;margin-top:9px;text-indent:0}
  .read-body :global(.plate-context){font:13px/1.9 var(--serif);color:var(--ink-2);background:var(--amber-faint);padding:12px 16px;text-indent:0;margin:0 0 2em}
  .read-body :global(.table-wrap){overflow-x:auto;margin:2em 0;border:1px solid var(--line);background:#fbf8f0}
  .read-body :global(table){border-collapse:collapse;width:100%;font:12px/1.55 var(--serif);min-width:560px}
  .read-body :global(caption){font:13px/1.7 var(--serif);text-align:left;padding:10px 12px 6px;color:var(--ink-2)}
  .read-body :global(th),.read-body :global(td){border-bottom:1px solid var(--line);padding:7px 9px;text-align:left;vertical-align:top;white-space:nowrap}
  .read-body :global(th){background:var(--paper-2);font-weight:500}
  .read-body :global(.table-note){font:12px/1.85 var(--serif);color:var(--ink-2);text-indent:0;margin-top:-1em}
  .read-body :global(.cite){color:var(--amber);text-decoration:none;font-size:.82em;white-space:nowrap}
  .read-body :global(.cite:hover){text-decoration:underline}
  .read-body :global(.source){border-bottom:1px solid var(--line);padding:12px 0;scroll-margin-top:90px}
  .read-body :global(.source p){margin:.3em 0;text-indent:0;font-size:14px;line-height:1.8}
  .read-body :global(.source .source-detail){color:var(--ink-2);font-size:13px}
  .read-body :global(.source a){color:var(--amber)}
  .read-body :global(.source:target){background:var(--amber-soft);outline:1px solid var(--amber-2);padding-left:10px;padding-right:10px}
  .read-pager{display:grid;grid-template-columns:1fr 1fr;gap:16px;border-top:1px solid var(--line);margin-top:52px;padding-top:22px}
  .read-pager a{display:flex;flex-direction:column;gap:5px;text-decoration:none;color:var(--ink);font:500 15px/1.6 var(--serif)}
  .read-pager a span{font:10px var(--mono);color:var(--ink-3);letter-spacing:.12em}
  .read-pager .next{text-align:right;align-items:flex-end}
  .read-pager a:hover{color:var(--amber)}
  .read-foot{display:flex;flex-wrap:wrap;gap:8px 14px;justify-content:center;font:11px var(--mono);color:var(--ink-3);margin-top:34px}
  .read-foot a{color:var(--ink-2);text-decoration:none}
  .read-foot a:hover{color:var(--amber)}
  @media(max-width:720px){.reading-page{padding:18px 16px 46px}.read-body{font-size:16px;line-height:2}.read-body :global(table){font-size:11px}.read-pager{grid-template-columns:1fr}.read-pager .next{text-align:left;align-items:flex-start}.read-crumb span{margin-left:0;width:100%}}
</style>
