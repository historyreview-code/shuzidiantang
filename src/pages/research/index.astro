---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { research, historyBookReports } from '../../data/research';
import { works } from '../../data/site';

const huanghe = works.find((work) => work.id === 'huanghe')!;
---
<BaseLayout current="research" title="专题研究 · 劳伦斯实验室" description="专题研究：历史研究（奉系 / 战争与归途）、俄罗斯远东、吉林船厂、云梦泽、萨满、黄河与土地制度等有出处、可核验的专题与电子书。">
  <main id="content" class="page">
    <section class="page-title research-title">
      <span class="kicker">专题研究 · Research</span>
      <h1>专题研究</h1>
      <p>从具体问题出发，追溯文化、历史与制度的依据，形成有出处、可核验的专题研究与电子书。按研究线索归档：历史研究、历史地理、文化研究与制度研究。</p>
    </section>

    <section class="section research-feature" aria-label="历史研究">
      <div class="section-head">
        <div>
          <span class="kicker">历史研究 · 子项目</span>
          <h2>奉系 / 战争与归途</h2>
        </div>
        <p class="section-side-note">两本独立的电子书，各有封面与入口：一部写奉系—东北军的兴起与解体，一部写从日俄战争到战后归途。</p>
      </div>
      <div class="research-archive">
        {historyBookReports.map((report) => <ResearchCard report={report} />)}
      </div>
    </section>

    <section class="section shaman-feature" aria-label="萨满研究">
      <div class="section-head">
        <div>
          <span class="kicker">文化研究 · 图文专著</span>
          <h2>萨满：与看不见的世界打交道</h2>
        </div>
        <p class="section-side-note">从西伯利亚到东亚，兼及环北极与美洲的萨满传统研究；12 章、约 9.1 万字、16 幅图，附术语表、年表与来源。</p>
      </div>
      <a class="shaman-study-card" href="/research/shamanism-study">
        <img src="/research/shamanism/research/figures/fig-03-relations.png" alt="萨满关系语法示意图" width="1000" height="820" loading="lazy" />
        <div class="shaman-study-copy">
          <span class="kicker">研究框架版 · 2026.11</span>
          <h3>关系、权威与历史</h3>
          <p>不是「萨满教是什么」，而是「萨满实践在做什么」：六次范式、14 节目录、9 幅示意图与 3 幅图版；可下载 EPUB/PDF 研究稿。</p>
          <span class="shaman-study-link">进入研究页 <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </section>

    <section class="section" aria-label="其他专题">
      <div class="section-head">
        <div>
          <span class="kicker">专题档案 · Archive</span>
          <h2>其他专题</h2>
        </div>
        <p class="section-side-note">历史地理、文化研究与制度研究；每份报告保留资料截止日期、适用地区与原始来源。</p>
      </div>
      <div class="research-archive">
        {research.map(report => <ResearchCard report={report} />)}
      </div>
    </section>

    <section class="section atlas-section" aria-label="交互图志">
      <div class="section-head">
        <div>
          <span class="kicker">交互图志 · Atlas</span>
          <h2>黄河 · 改道两千年</h2>
        </div>
        <p class="section-side-note">历史地理的可交互读法：滚动看叙事，拨时间轴看河道显影。</p>
      </div>
      <a class="atlas-card" href={huanghe.href}>
        <img src={huanghe.image} alt={`${huanghe.title}预览`} loading="lazy" decoding="async" />
        <div class="atlas-copy">
          <span class="kicker">{huanghe.eyebrow}</span>
          <h3>{huanghe.title}</h3>
          <p>{huanghe.summary}</p>
          <span class="atlas-link">打开交互图志 <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </section>

    <section class="section research-method">
      <span class="kicker">研究方法</span>
      <div><h2>先给结论，再展开依据。</h2><p>每份报告保留资料截止日期、适用地区与原始来源。事实、测算假设和研究判断分别交代，让结论可以复核，也能随新材料继续更新。</p></div>
    </section>
  </main>
</BaseLayout>
<style>

  .shaman-feature{padding-top:24px}
  .shaman-study-card{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:32px;align-items:center;padding:24px;border:1px solid var(--line);background:var(--card);border-radius:5px;color:var(--ink);text-decoration:none;transition:border-color .2s ease,transform .2s ease}
  .shaman-study-card:hover{border-color:var(--amber);transform:translateY(-2px)}
  .shaman-study-card > img{display:block;width:100%;height:auto;border:1px solid var(--line);background:#f8f4ea}
  .shaman-study-copy h3{font:600 clamp(24px,2.6vw,32px)/1.45 var(--serif);margin:10px 0 12px}
  .shaman-study-copy p{font-size:14px;line-height:1.95;color:var(--ink-2)}
  .shaman-study-link{display:inline-flex;gap:8px;margin-top:8px;font-size:13px;color:var(--amber)}
  @media(max-width:820px){.shaman-study-card{grid-template-columns:1fr;gap:20px;padding:16px}}
  .research-archive{display:grid;gap:24px}
  .research-title{padding-bottom:16px}
  .research-feature .section-head h2{font:600 30px/1.4 var(--serif);margin:8px 0 0}
  .section-side-note{max-width:430px;font-size:13px;line-height:1.9;color:var(--ink-3);text-align:right}
  .research-feature{padding-top:36px}
  .atlas-card { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 34px; align-items: center; padding: 24px; border: 1px solid var(--line); background: var(--card); border-radius: 5px; color: var(--ink); text-decoration: none; transition: border-color .2s ease, transform .2s ease; }
  .atlas-card:hover { border-color: var(--amber); transform: translateY(-2px); }
  .atlas-card > img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border: 1px solid var(--line); background: #e9e4d8; }
  .atlas-copy h3 { font: 600 clamp(24px, 2.6vw, 32px)/1.45 var(--serif); margin: 10px 0 12px; }
  .atlas-copy p { font-size: 14px; line-height: 1.95; color: var(--ink-2); }
  .atlas-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-size: 13px; color: var(--amber); }
  .research-method{display:grid;grid-template-columns:160px 1fr;gap:30px;border-top:1px solid var(--line);padding-top:35px;margin-bottom:30px}
  .research-method h2{font:500 26px/1.5 var(--serif);margin:0 0 15px}
  .research-method p{max-width:680px;font-size:14px;line-height:2;color:var(--ink-2)}
  @media(max-width:720px){
    .section-head{display:block}
    .section-side-note{text-align:left;margin-top:12px}
    .atlas-card { grid-template-columns: 1fr; gap: 20px; padding: 16px; }
    .research-method{grid-template-columns:1fr;gap:15px}
  }
</style>
