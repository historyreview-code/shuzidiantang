  <main id="content" class="page">
    <section class="page-title">
      <span class="meta">404</span>
      <h1>这间展厅还没开放</h1>
      <p>你访问的页面不存在，或者它还在施工中。</p>
      <div class="inline-actions">
        <a class="button primary" href="/">返回首页</a>
        <a class="button" href="/works/">进入作品馆</a>
      </div>
    </section>
  </main>
</BaseLayout>
