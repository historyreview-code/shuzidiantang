---
import BaseLayout from '../layouts/BaseLayout.astro';
import CosmosSeries from '../components/CosmosSeries.astro';
import TravelSeries from '../components/TravelSeries.astro';
import { works } from '../data/site';
---
<BaseLayout current="works" title="作品 · 劳伦斯实验室" description="数字地球、网页游戏、天文影像、陶土手作与数据艺术——每件作品都有真实入口。">
  <main id="content" class="page">
    <section class="section">
      <div class="work-grid">
        {works.map((work) => (
          <article class="work-card">
            <a class="card-link" href={work.href} aria-label={`${work.title}，进入作品`} {...work.external ? { target: '_blank', rel: 'noopener' } : {}}></a>
            <img src={work.image} alt={`${work.title}封面`} loading="lazy" />
            <div class="work-card-body">
              <span class="meta">{work.eyebrow} · {work.status}</span>
              <h3>{work.title}</h3>
              <p>{work.summary}</p>
              <div class="tag-list">{work.tags.map((tag) => <span>{tag}</span>)}
              {work.github && <a class="github-badge" href={work.github} target="_blank" rel="noopener">⌥ 开源代码 ↗</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section">
      <TravelSeries />
    </section>
    <section class="section">
      <CosmosSeries />
    </section>
  </main>
</BaseLayout>
