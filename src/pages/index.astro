---
import BaseLayout from '../layouts/BaseLayout.astro';
import CosmosSeries from '../components/CosmosSeries.astro';
import TravelSeries from '../components/TravelSeries.astro';
import { cosmosSeries, notes, site, works } from '../data/site';

const categories = ['实践手记', 'AI 手记', '工具篇', '随笔'];

// 右侧轮播：地球、天文系列、陶土、数据艺术、CAD 五件主力
const carousel = [
  ...works.slice(0, 1).map((w) => ({
    name: w.title,
    eyebrow: `${w.eyebrow} · ${w.status}`,
    note: w.summary,
    img: w.image,
    href: w.href,
  })),
  {
    name: '天文馆 · 宇宙之旅',
    eyebrow: '系列 · 六集六主题',
    note: `${cosmosSeries.length} 集天文短片，一集一个主题：从黄道面到揽月探火，点卡直接放映。`,
    img: cosmosSeries[0].img,
    href: '/cosmos/',
  },
  ...works.slice(1, 4).map((w) => ({
    name: w.title,
    eyebrow: `${w.eyebrow} · ${w.status}`,
    note: w.summary,
    img: w.image,
    href: w.href,
  })),
];

const recommend = {
  kicker: '系列推荐 · B站',
  title: '英伦漫记',
  desc: '把在英国的速写与漫步剪成影像笔记：路上的风景、建筑与手账，一集一集慢慢放。',
  href: 'https://space.bilibili.com/13483307/video',
  cta: '去 B站 看系列',
  yt: '海外同步：YouTube @SketchbookBritain',
  ytHref: 'https://www.youtube.com/@SketchbookBritain',
};
---
<BaseLayout current="home">
  <main id="content" class="page">
    <!-- ============ Hero ============ -->
    <section class="hero">
      <div class="hero-copy">
        <div class="hero-kicker-row">
          <span class="stamp" aria-hidden="true">数字</span>
          <span class="kicker">Shuzidiantang.com · 个人主站</span>
        </div>
        <h1 class="hero-title">劳伦斯<span class="accent">在上海</span></h1>
        <p class="hero-lead">学习和分享 AI 实践，探索未知世界。</p>
      </div>

      <div class="hero-side">
        <figure class="exhibit" id="exhibit">
          <a class="exhibit-frame" id="ex-link" href={carousel[0].href}>
            <img id="ex-img" src={carousel[0].img} alt={`${carousel[0].name}预览`} />
          </a>
          <figcaption class="exhibit-label">
            <span class="stamp" aria-hidden="true">数字</span>
            <div>
              <span id="ex-eyebrow">{carousel[0].eyebrow}</span>
              <strong id="ex-name">{carousel[0].name}</strong>
            </div>
          </figcaption>
          <div class="exhibit-dots" id="ex-dots" role="tablist" aria-label="主力作品轮换"></div>
          <p class="exhibit-note" id="ex-note">{carousel[0].note}</p>
        </figure>
      </div>
    </section>

    <!-- ============ 作品卡片流 ============ -->
    <section class="section" id="works">
      <div class="works-stream">
        {works.map((work, index) => (
          <>
            <a class="work-stream-item" href={work.href}>
              <div class="ws-thumb">
                <img src={work.image} alt={`${work.title}预览`} loading="lazy" />
              </div>
              <div class="ws-body">
                <span class="ws-num">NO.{String(index + 1).padStart(2, '0')} · {work.eyebrow}</span>
                <h3>{work.title}</h3>
                <p>{work.summary}</p>
                <div class="tag-list">
                  {work.tags.map((tag) => <span>{tag}</span>)}
                </div>
                <div class="ws-meta">
                  <span class="ws-status">{work.status}</span>
                  <span class="ws-enter">进入 →</span>
                  {work.github && <a class="github-badge" href={work.github} target="_blank" rel="noopener">⌥ 开源代码 ↗</a>}
                </div>
              </div>
            </a>
          </>
        ))}
      </div>
    </section>

    <!-- ============ 旅行实验室系列（提前：作品流之后） ============ -->
    <section class="section" id="travel">
      <TravelSeries />
    </section>

    <!-- ============ 天文与宇宙系列（靠后位置） ============ -->
    <section class="section" id="cosmos">
      <CosmosSeries />
    </section>

    <!-- ============ 系列推荐位 ============ -->
    <section class="section">
      <div class="recommend">
        <div class="recommend-copy">
          <span class="kicker">{recommend.kicker}</span>
          <h3>{recommend.title}</h3>
          <p>{recommend.desc}</p>
          <a class="yt" href={recommend.ytHref} target="_blank" rel="noopener">{recommend.yt}</a>
        </div>
        <a class="button primary" href={recommend.href} target="_blank" rel="noopener">{recommend.cta}</a>
      </div>
    </section>

    <!-- ============ 手记流 ============ -->
    <section class="section">
      <div class="section-head">
        <div>
          <span class="kicker">手记 · Notes</span>
          <h2>把制作过程留在纸上</h2>
          <div class="cat-chips" aria-label="手记分类">
            {categories.map((c, i) => <span class:list={[i === 0 && 'active']}>{c}</span>)}
          </div>
        </div>
        <div class="side">
          <p>实践手记、AI 手记、工具篇、随笔——问题、选择和修复过程，都归档在这里。</p>
        </div>
      </div>
      <div class="notes-feed">
        <!-- AUTO:NOTES_FEED -->
        <a class="item" href="/notes/2026-09-01-blender-pipeline.html"><span class="date">2026-09-01</span><span class="txt">一条 Blender 生产线：陶土手作、室内软装与小区效果图<small>工具篇</small></span></a>
        <a class="item" href="/notes/2026-08-17-numsweeper.html"><span class="date">2026-08-17</span><span class="txt">不踩雷，只算数——数字扫雷的创意与进化之路<small>实践手记</small></span></a>
        <a class="item" href="/notes/2026-08-16-digital-earth-series.html"><span class="date">2026-08-16</span><span class="txt">一个会转的地球，装下了大学、世界遗产和 500 强<small>实践手记</small></span></a>
        <a class="item" href="/notes/2026-08-16-ai-tools-personal-website.html"><span class="date">2026-08-16</span><span class="txt">用好 AI 工具，你也可以拥有个人网站<small>工具篇</small></span></a>
        <!-- /AUTO:NOTES_FEED -->
      </div>
      <div class="notes-more">
        <a class="button" href="/notes/">全部手记</a>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ carousel }}>
    (function () {
      var items = carousel;
      var img = document.getElementById('ex-img');
      var link = document.getElementById('ex-link');
      var nameEl = document.getElementById('ex-name');
      var eyebrowEl = document.getElementById('ex-eyebrow');
      var noteEl = document.getElementById('ex-note');
      var dotsBox = document.getElementById('ex-dots');
      var figure = document.getElementById('exhibit');
      var idx = 0, timer = null, paused = false;

      items.forEach(function (it, i) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-label', it.name);
        b.addEventListener('click', function () { show(i); restart(); });
        dotsBox.appendChild(b);
      });

      function show(i) {
        idx = (i + items.length) % items.length;
        var it = items[idx];
        img.style.opacity = '0';
        setTimeout(function () {
          img.alt = it.name + '预览';
          img.onload = function () { img.style.opacity = '1'; };
          img.src = it.img;
          link.href = it.href;
          nameEl.textContent = it.name;
          eyebrowEl.textContent = it.eyebrow;
          noteEl.textContent = it.note;
        }, 450);
        dotsBox.querySelectorAll('button').forEach(function (b, j) {
          b.classList.toggle('on', j === idx);
        });
      }

      function restart() {
        if (timer) clearInterval(timer);
        if (!paused) timer = setInterval(function () { show(idx + 1); }, 4500);
      }

      var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced) {
        figure.addEventListener('mouseenter', function () { paused = true; if (timer) clearInterval(timer); });
        figure.addEventListener('mouseleave', function () { paused = false; restart(); });
      }
      show(0);
      if (!reduced) restart();
    })();
  </script>
</BaseLayout>
