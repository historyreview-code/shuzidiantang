---
import BaseLayout from '../layouts/BaseLayout.astro';

// 前 10 只：三视图（正 / 侧 / 背，马为 主照/侧/头）；新 6 只：单张多视角拼图
const animals = [
  { num: '00', name: '马', views: 3 },
  { num: '01', name: '羊', views: 3 },
  { num: '02', name: '鹿', views: 3 },
  { num: '03', name: '猫', views: 3 },
  { num: '04', name: '犬', views: 3 },
  { num: '05', name: '兔', views: 3 },
  { num: '06', name: '猪', views: 3 },
  { num: '07', name: '象', views: 3 },
  { num: '08', name: '鸭', views: 3 },
  { num: '09', name: '狐狸', views: 3 },
  { num: '11', name: '老虎', views: 3 },
  { num: '12', name: '鹈鹕', views: 3 },
  { num: '13', name: '熊猫', views: 3 },
  { num: '14', name: '卡皮巴拉', views: 3 },
  { num: '15', name: '玉兔', views: 3 },
  { num: '16', name: '青铜犀甲虫', views: 3 },
];
---
<BaseLayout current="works" title="陶土动物园 · 劳伦斯在上海" description="十七只用 Blender 捏出来的陶土小动物图鉴：前 10 只点击切换三视图，附全家福。">
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">作品 · Blender 手作</span>
      <h1>陶土动物园</h1>
      <p>
        十七只用 Blender 捏出来的陶土小动物：从捏形、上釉到打光，一只一只手作入馆。
        点击图片切换三视图，最后一张全家福，给动物园收尾。
      </p>
    </header>

    <section class="clay-family">
      <figure class="exhibit">
        <div class="exhibit-frame">
          <img src="/assets/img/clay/10.webp" alt="陶土动物园全家福" />
        </div>
        <figcaption class="exhibit-label">
          <span class="stamp" aria-hidden="true">陶</span>
          <div>
            <span>全家福 · Family Photo</span>
            <strong>陶土动物园 · 十七只到齐</strong>
          </div>
        </figcaption>
      </figure>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="kicker">图鉴 · Catalog</span>
          <h2>十七只小动物，一只一页</h2>
        </div>
        <div class="side">
          <p>点击图片切换三视图（正 / 侧 / 背）。</p>
        </div>
      </div>
      <div class="clay-grid">
        {animals.map((a) => (
          <article class="clay-card" data-num={a.num} data-views={a.views}>
            <div class="clay-frame">
              <img src={`/assets/img/clay/${a.num}-0.webp`} alt={`陶土${a.name}`} loading="lazy" />
            </div>
            <div class="clay-body">
              <span class="meta">NO.{a.num}</span>
              <h3>{a.name}</h3>
              <span class="view-indicator" aria-hidden="true"></span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="notes-more">
      <a class="button" href="/notes/2026-09-01-blender-pipeline.html">📖 制作幕后 · Blender 手记</a>
      <a class="button" href="/works/">返回作品</a>
    </div>
  </main>
</BaseLayout>

<script>
  document.querySelectorAll('.clay-card').forEach((card) => {
    const views = Number(card.dataset.views);
    if (views <= 1) return;
    const num = card.dataset.num;
    const img = card.querySelector('.clay-frame img');
    const indicator = card.querySelector('.view-indicator');
    let idx = 0;
    const update = () => {
      indicator.textContent = `${idx + 1}/${views} · 点击切换`;
    };
    update();
    card.querySelector('.clay-frame').addEventListener('click', () => {
      idx = (idx + 1) % views;
      img.style.opacity = '0';
      setTimeout(() => {
        img.src = `/assets/img/clay/${num}-${idx}.webp`;
        img.onload = () => { img.style.opacity = '1'; };
      }, 250);
      update();
    });
  });
</script>

<style>
  .clay-family { max-width: 560px; margin: 8px auto 0; }
  .clay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }
  .clay-card {
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .clay-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: var(--shadow-lift);
  }
  .clay-frame {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
    cursor: pointer;
  }
  .clay-frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }
  .clay-body {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 14px 16px;
    flex-wrap: wrap;
  }
  .clay-body h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    flex: 1;
  }
  .view-indicator {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }
</style>
