---
import BaseLayout from '../layouts/BaseLayout.astro';

const animals = [
  { num: '00', name: '马', views: 3 },
  { num: '01', name: '羊', views: 3 },
  { num: '02', name: '鹿', views: 3 },
  { num: '03', name: '猫', views: 3 },
  { num: '04', name: '犬', views: 3 },
  { num: '05', name: '兔', views: 3 },
  { num: '06', name: '猪', views: 3 },
  { num: '07', name: '象', views: 3 },
  { num: '08', name: '鸭', views: 3 },
  { num: '09', name: '狐狸', views: 3 },
  { num: '11', name: '老虎', views: 3 },
  { num: '12', name: '鹈鹕', views: 3 },
  { num: '13', name: '熊猫', views: 3 },
  { num: '14', name: '卡皮巴拉', views: 3 },
  { num: '15', name: '玉兔', views: 3 },
  { num: '16', name: '青铜犀甲虫', views: 3 },
];
---
<BaseLayout current="works" title="陶土动物园 · 劳伦斯实验室" description="十七只用 Blender 手作的小动物图鉴：陶土为底，兼有玉石与青铜质感。点击任意一只，满屏自动播放三视图。">
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">作品 · Blender 手作</span>
      <h1>陶土动物园</h1>
      <p>
        十七只用 Blender 手作的小动物——陶土为底，也尝试玉石与青铜的质感：
        从捏形、上釉到打光，一只一只入馆。点击任意一只，满屏自动播放它的三视图。
      </p>
    </header>

    <section class="section">
      <div class="clay-grid">
        {animals.map((a) => (
          <article class="clay-card" data-num={a.num} data-name={a.name} data-views={a.views}>
            <div class="clay-frame">
              <img src={`/assets/img/clay/${a.num}-0.webp`} alt={`陶土${a.name}`} loading="lazy" />
            </div>
            <div class="clay-body">
              <span class="meta">NO.{a.num}</span>
              <h3>{a.name}</h3>
              <span class="view-indicator" aria-hidden="true">点击看三视图</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="notes-more">
      <a class="button" href="/notes/2026-09-01-blender-pipeline.html">📖 制作幕后 · Blender 手记</a>
      <a class="button" href="/works/">返回作品</a>
    </div>
  </main>

  <div id="clay-overlay" class="clay-overlay" aria-hidden="true">
    <div class="co-stage">
      <img id="co-img" src="" alt="动物三视图" />
    </div>
    <div class="co-bar">
      <span id="co-name">—</span>
      <span id="co-indicator" aria-hidden="true"></span>
      <span class="co-hint">点击任意处返回</span>
    </div>
  </div>
</BaseLayout>

<script>
  const overlay = document.getElementById('clay-overlay');
  const img = document.getElementById('co-img');
  const nameEl = document.getElementById('co-name');
  const indicator = document.getElementById('co-indicator');
  let timer = null;
  let views = 0;
  let idx = 0;
  let num = '';

  function close() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    if (timer) { clearInterval(timer); timer = null; }
  }

  function advance() {
    idx = idx + 1;
    if (idx >= views) {
      // 三视图播完：回到第一视图并停止
      idx = 0;
      img.src = `/assets/img/clay/${num}-0.webp`;
      indicator.textContent = `1/${views}`;
      if (timer) { clearInterval(timer); timer = null; }
      return;
    }
    img.src = `/assets/img/clay/${num}-${idx}.webp`;
    indicator.textContent = `${idx + 1}/${views}`;
  }

  function open(card) {
    num = card.dataset.num;
    views = Number(card.dataset.views);
    nameEl.textContent = card.dataset.name;
    idx = 0;
    img.style.opacity = '1';
    img.src = `/assets/img/clay/${num}-0.webp`;
    indicator.textContent = `1/${views}`;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    if (timer) clearInterval(timer);
    const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (views > 1 && !reduced) {
      timer = setInterval(advance, 1800);
    }
  }

  document.querySelectorAll('.clay-card').forEach((card) => {
    card.addEventListener('click', () => open(card));
  });
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>

<style>
  .clay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }
  .clay-card {
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .clay-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: var(--shadow-lift);
  }
  .clay-frame {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .clay-frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .clay-body {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding: 14px 16px;
    flex-wrap: wrap;
  }
  .clay-body h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    flex: 1;
  }
  .view-indicator {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
  }
  /* 满屏三视图播放层 */
  .clay-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: none;
    flex-direction: column;
    background: rgba(26, 22, 16, 0.94);
    cursor: zoom-out;
  }
  .clay-overlay.open { display: flex; }
  .co-stage {
    flex: 1;
    display: grid;
    place-items: center;
    padding: 20px;
  }
  .co-stage img {
    max-width: 100%;
    max-height: 100%;
    border: 1px solid rgba(246, 241, 229, 0.25);
    background: var(--paper-2);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    transition: opacity 0.22s ease;
  }
  .co-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 18px;
    padding: 16px;
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .co-bar #co-name { font-family: var(--serif); font-size: 1.15rem; }
  .co-bar .co-hint { color: rgba(246, 241, 229, 0.55); font-size: 0.72rem; }
</style>
