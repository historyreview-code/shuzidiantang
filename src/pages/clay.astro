---
import BaseLayout from '../layouts/BaseLayout.astro';

const animals = [
  ['00', '马'],
  ['01', '羊'],
  ['02', '鹿'],
  ['03', '猫'],
  ['04', '犬'],
  ['05', '兔'],
  ['06', '猪'],
  ['07', '象'],
  ['08', '鸭'],
  ['09', '狐狸'],
  ['11', '老虎'],
  ['12', '鹈鹕'],
  ['13', '熊猫'],
  ['14', '卡皮巴拉'],
  ['15', '玉兔'],
  ['16', '青铜犀甲虫'],
];
---
<BaseLayout current="works" title="陶土动物园 · 数字殿堂" description="十七只用 Blender 捏出来的陶土小动物图鉴，附全家福。">
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">作品 · Blender 手作</span>
      <h1>陶土动物园</h1>
      <p>
        十七只用 Blender 捏出来的陶土小动物：从捏形、上釉到打光，一只一只手作入馆。
        每只都有自己的姿态和脾气，最后一张全家福，给动物园收尾。
      </p>
    </header>

    <section class="clay-family">
      <figure class="exhibit">
        <div class="exhibit-frame">
          <img src="/assets/img/clay/10.webp" alt="陶土动物园全家福" />
        </div>
        <figcaption class="exhibit-label">
          <span class="stamp" aria-hidden="true">陶</span>
          <div>
            <span>全家福 · Family Photo</span>
            <strong>陶土动物园 · 十七只到齐</strong>
          </div>
        </figcaption>
      </figure>
    </section>

    <section class="section">
      <div class="section-head">
        <div>
          <span class="kicker">图鉴 · Catalog</span>
          <h2>十七只小动物，一只一页</h2>
        </div>
        <div class="side">
          <p>按入馆顺序编号。前 10 只放主照，新入馆的 6 只先放多视角拼图。</p>
        </div>
      </div>
      <div class="clay-grid">
        {animals.map(([num, name]) => (
          <article class="clay-card">
            <div class="clay-frame">
              <img src={`/assets/img/clay/${num}.webp`} alt={`陶土${name}`} loading="lazy" />
            </div>
            <div class="clay-body">
              <span class="meta">NO.{num}</span>
              <h3>{name}</h3>
            </div>
          </article>
        ))}
      </div>
    </section>

    <div class="notes-more">
      <a class="button" href="/works/">返回作品馆</a>
    </div>
  </main>
</BaseLayout>

<style>
  .clay-family { max-width: 560px; margin: 8px auto 0; }
  .clay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 18px;
  }
  .clay-card {
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .clay-card:hover {
    transform: translateY(-4px);
    border-color: var(--amber);
    box-shadow: var(--shadow-lift);
  }
  .clay-frame {
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .clay-frame img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .clay-body {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 16px;
  }
  .clay-body h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.25rem;
  }
</style>
