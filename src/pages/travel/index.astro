---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { travelSeries } from '../../data/site';

const biliVideos = travelSeries.filter((item) => item.external && item.href).slice(0, 3);

const exhibits = [
  { num: '04', title: '悠游 · 约克，把时间走慢', desc: '16 处地标与 16 篇手记，5 个餐食备选、6 条路线。城墙与河流 · 博物与街巷 · 一口甜。', href: '/travel/york/', img: '/travel/york/cover.svg?v=1', tag: '手机漫游' },
  { num: '05', title: '悠游 · 剑桥，沿河读世界', desc: '16 处地标与 16 篇手记，5 个餐食备选、6 条路线。康河与学院 · 艺术与科学 · 好奇心。', href: '/travel/cambridge/', img: '/travel/cambridge/cover.svg?v=1', tag: '手机漫游' },
  { num: '06', title: '悠游 · 格拉斯哥，城里有回响', desc: '16 处地标与 16 篇手记，5 个餐食备选、6 条路线。红砂岩与艺术 · 克莱德河 · 公园深处。', href: '/travel/glasgow/', img: '/travel/glasgow/cover.svg?v=1', tag: '手机漫游' },
  { num: '03', title: '悠游 · 哈尔滨，心里有暖', desc: '20 个漫游点与 20 篇手记；冬天分段取暖，夏天追一阵江风，6 种地方滋味、7 条主题路线。', href: '/travel/harbin/', img: '/travel/harbin/cover.svg?v=1', tag: '手机漫游' },
  { num: 'NEW', title: '悠游 · 爱丁堡，慢一点看见', desc: '20 处景点、20 篇漫游手记与 5 家餐食备选；从老城山脊走向河谷与海滨。', href: '/travel/edinburgh/', img: '/travel/edinburgh/cover.svg?v=2', tag: '手机漫游' },
  { num: 'NEW', title: '悠游 · 京都，不必赶路', desc: '24 处景点与博物美术馆，24 篇第一人称情境体验；在全屏地图上规划漫游。', href: '/travel/kyoto/', img: '/travel/kyoto/cover.svg', tag: '手机漫游' },
  { num: 'NO.01', title: '会飞的路书', desc: '点击任意一天，地图飞到当天路段。', href: '/travel/uk-roadbook/', img: '/assets/img/travel/uk-roadbook.webp', tag: '交互' },
  { num: 'NO.02', title: '小红书卡片工具', desc: '输入行程基础数据，自动生成手绘水彩卡片。', href: '/travel/xhs-card/', img: '/assets/img/travel/lab.webp', tag: '自动出图' },
];
---
<BaseLayout current="works" title="旅行实验室 · 劳伦斯实验室" description="旅行实验室：会飞的路书、小红书卡片工具与旅行记录视频。">
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">城市悠游 · Travel Lab</span>
      <h1>城市悠游</h1>
      <p>
        六座城市，六段可以慢慢走的交互漫游：每座城市有缩微地标、有来源的编辑部手记与主题路线，
        支持手机全屏地图与离线资料。另附两件旅行工具：会飞的路书与小红书手绘卡片。
        <a class="github-badge" href="https://www.bilibili.com/video/BV1gH4k63EUm" target="_blank" rel="noopener">▶ B站演示 ↗</a>
      </p>
    </header>

    <section class="section">
      <div class="work-grid collection-grid">
        {exhibits.map((e) => (
          <a class="work-card" href={e.href}>
            <img src={e.img} alt={`${e.title}预览`} />
            <div class="work-card-body">
              <span class="meta">{e.num} · {e.tag}</span>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
            </div>
          </a>
        ))}
        <article class="work-card" aria-label="旅行记录视频，后补">
          <div class="card-ph" aria-hidden="true"><span class="stamp">后补</span></div>
          <div class="work-card-body">
            <span class="meta">NO.03 · 占位</span>
            <h3>旅行记录视频</h3>
            <p>照片自动编排成片，工具打磨好后补上。</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section outbound" aria-label="站外视频">
      <div class="outbound-copy">
        <span class="kicker">站外视频 · 下一层</span>
        <h2>手绘跨时空旅行 · 英伦漫记</h2>
        <p>九部手绘短片发布在 B 站，按城市与小镇各成一集。站内只保留目录与封面，点进子页再转到站外观看。</p>
        <a class="button" href="/travel/films/">查看站外视频目录 <span aria-hidden="true">→</span></a>
      </div>
      <div class="outbound-thumbs">
        {biliVideos.map((video) => (
          <a href="/travel/films/" aria-label={`${video.title}（站外视频目录）`}>
            <img src={video.img} alt={`${video.title}封面`} loading="lazy" decoding="async" />
            <span>{video.title}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="notes-more">
      <a class="button" href="/">返回首页</a>
    </div>
  </main>
</BaseLayout>

<style>
  .outbound { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 44px; align-items: center; border-top: 1px solid var(--line); }
  .outbound h2 { font: 600 clamp(24px, 2.6vw, 32px)/1.5 var(--serif); margin: 12px 0 14px; }
  .outbound-copy p { max-width: 520px; font-size: 13px; line-height: 1.95; color: var(--ink-2); margin-bottom: 22px; }
  .outbound-thumbs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .outbound-thumbs a { display: block; text-decoration: none; color: var(--ink-3); font-size: 11px; }
  .outbound-thumbs img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border: 1px solid var(--line); background: #e9e4d8; transition: transform .18s ease, border-color .18s ease; }
  .outbound-thumbs a:hover img { transform: translateY(-3px); border-color: var(--amber); }
  .outbound-thumbs span { display: block; padding-top: 6px; }
  @media (max-width: 820px) { .outbound { grid-template-columns: 1fr; gap: 24px; } .outbound-thumbs { max-width: 420px; } }
</style>
