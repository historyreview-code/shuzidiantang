---
import BaseLayout from '../../layouts/BaseLayout.astro';

const exhibits = [
  { num: 'NO.01', title: '会飞的手账', desc: '点击任意一天，地图飞到当天路段。', href: '/travel/uk-roadbook/', img: '/assets/img/travel/uk-roadbook.webp', tag: '交互' },
  { num: 'NO.02', title: '手绘风小红书卡', desc: '输入行程基础数据，自动生成手绘水彩卡片。', href: '/travel/xhs-card/', img: '/assets/img/travel/lab.webp', tag: '自动出图' },
];
---
<BaseLayout current="works" title="旅行实验室 · 劳伦斯在上海" description="旅行实验室：会飞的手账、手绘风小红书卡与旅行视频生成。">
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">旅行实验室 · Travel Lab</span>
      <h1>旅行实验室</h1>
      <p>
        旅行目的地的历史文化手绘介绍，路线确定后生成路书，作为旅途助手；
        途中产出小红书发布卡片，照片与视频用旅行视频工具生成记录短片。
        一切都智能高效，富有知识向和审美标准。
      </p>
    </header>

    <section class="section">
      <div class="work-grid collection-grid">
        {exhibits.map((e) => (
          <a class="work-card" href={e.href}>
            <img src={e.img} alt={`${e.title}预览`} />
            <div class="work-card-body">
              <span class="meta">{e.num} · {e.tag}</span>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
            </div>
          </a>
        ))}
        <article class="work-card" aria-label="旅行视频生成，后补">
          <div class="card-ph" aria-hidden="true"><span class="stamp">后补</span></div>
          <div class="work-card-body">
            <span class="meta">NO.03 · 占位</span>
            <h3>旅行视频生成</h3>
            <p>照片自动编排成片，工具打磨好后补上。</p>
          </div>
        </article>
      </div>
    </section>

    <div class="notes-more">
      <a class="button" href="/">返回首页</a>
    </div>
  </main>
</BaseLayout>
