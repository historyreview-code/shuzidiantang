---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const socials = [
  {
    platform: 'B站',
    handle: '劳伦斯在sh',
    href: 'https://space.bilibili.com/13483307',
    cta: '进入 B站主页',
  },
  {
    platform: '小红书',
    handle: '劳伦斯在sh',
    href: 'https://www.xiaohongshu.com/user/profile/5d8d47d80000000001019d89',
    cta: '进入小红书主页',
  },
  {
    platform: 'YouTube',
    handle: '@SketchbookBritain',
    href: 'https://www.youtube.com/@SketchbookBritain',
    cta: '进入 YouTube 频道',
  },
];
---
<BaseLayout current="about" title={`关于 · ${site.name}`}>
  <main id="content" class="page">
    <header class="page-title">
      <span class="kicker">关于 · About</span>
      <h1>劳伦斯在上海</h1>
      <p>
        常驻上海，做数字作品，也给作品写手记。
        这里每件展品都来自一次「想做出来看看」的冲动：会转的地球、自动放映的星空、
        可以玩的小游戏、Blender 捏的陶土动物，还有随十二时辰流转的数据艺术。
        作品做完了不算完——过程会写进手记，留给想看的人。
      </p>
    </header>

    <section class="section">
      <div class="channel-grid">
        {socials.map((s) => (
          <article class="channel-card">
            <span class="meta">{s.platform}</span>
            <h3>{s.handle}</h3>
            <a class="button" href={s.href} target="_blank" rel="noopener">{s.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="contact-line">
        <span class="kicker">合作 · Contact</span>
        <a href="mailto:newz2021@qq.com?subject=来自劳伦斯在上海主站的合作联系">newz2021@qq.com</a>
        <span class="contact-sub">旅行路线定制 · 手绘地图 · 效果图 · 数据可视化</span>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px 18px;
  }
  .contact-line a {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid var(--amber);
    padding: 2px 0;
  }
  .contact-line a:hover { color: var(--amber); }
  .contact-sub {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
</style>
