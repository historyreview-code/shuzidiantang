---
import BaseLayout from '../../layouts/BaseLayout.astro';

const film = '/films/electricity/hls/index.m3u8';
const mp4 = '/films/electricity/electricity-web.mp4';
const poster = '/films/electricity/poster.webp';
const cover = '/films/electricity/cover.webp';
const storyboard = '/films/electricity/storyboard.webp';
const chapters = [
  { time: 0, stamp: '00:00', title: '序 · 暴风雨', note: '一道闪电，把人类的目光带向天空。' },
  { time: 10.5, stamp: '00:10', title: '琥珀 · 摩擦起电', note: '电子从毛皮搬到琥珀，正负电荷第一次被看见。' },
  { time: 21.9, stamp: '00:21', title: '天空 · 风筝实验', note: '钥匙上的火花，接通了天空与实验室。' },
  { time: 38, stamp: '00:38', title: '电流 · 伏打电堆', note: '铜、锌与盐水叠在一起，化学能开始推动电荷。' },
  { time: 52.3, stamp: '00:52', title: '电磁 · 奥斯特与法拉第', note: '电流让磁针偏转，变化的磁场又生出电流。' },
  { time: 69.1, stamp: '01:09', title: '电网 · 制造与传输', note: '交流电升压、跨越山川，再降压进入万家灯火。' },
  { time: 80.7, stamp: '01:20', title: '此刻 · 电的文明', note: '城市、芯片与火箭，都建立在这束光上。' },
  { time: 91.15, stamp: '01:31', title: '尾声 · 回到琥珀', note: '一切从一块被摩擦过的琥珀开始。' },
];
---
<BaseLayout current="works" title="电 · 从琥珀到星火 — 劳伦斯实验室" description="95 秒竖屏科学动画：从摩擦琥珀、富兰克林风筝、伏打电堆、奥斯特与法拉第，到高压电网与夜地球。用镜头解释电的科学原理，MiniMax doc_commentary 旁白，画面、配乐与音效由代码生成。" image={cover}>
  <main id="content" class="page film-page">
    <header class="page-title">
      <span class="kicker">影像作品 · 科学史动画</span>
      <h1>电</h1>
      <p class="film-en">FROM AMBER TO STARFIRE</p>
      <p>从一块被摩擦的琥珀，到一颗被点亮的行星。<br />95 秒，七章，一次关于电的认知史。</p>
      <div class="film-meta"><span>2026.10.18</span><span>1 分 35 秒</span><span>源片 1080 × 1920 · 30 帧</span><span>MiniMax 旁白</span></div>
    </header>

    <section class="vertical-stage" aria-label="电 · 从琥珀到星火放映厅">
      <div class="screen-column">
        <div class="phone">
          <div class="phone-bar"><span>A SHORT HISTORY OF ELECTRICITY</span><span>01:35</span></div>
          <video id="electricity-player" controls playsinline preload="metadata" poster={poster} data-source={film} aria-label="播放电 · 从琥珀到星火，95 秒竖屏科学动画" aria-describedby="film-caption"></video>
          <noscript><p class="playback-error">请启用 JavaScript，或<a href={mp4}>直接打开轻量版 MP4</a>。</p></noscript>
        </div>
        <div class="screening-caption" id="film-caption"><span>建议开启声音 · 1 分 35 秒</span><a href={mp4} download="电·从琥珀到星火.mp4">下载轻量版 MP4（8.9 MB）↓</a></div>
        <p class="playback-error" id="playback-error" hidden>视频暂未加载成功。可以<a href={mp4}>直接打开轻量版 MP4</a>，或稍后重新播放。</p>
      </div>

      <aside class="stage-aside">
        <span class="kicker">七章 · Chapters</span>
        <h2>从琥珀，<br />到星火</h2>
        <p class="stage-intro">这不是一部按年代罗列发明的时间线。它把古人的观察与今天的物理解释叠在同一个镜头里：先看见现象，再走进现象内部。</p>
        <div class="movement-list">
          {chapters.map((chapter) => (
            <button class="movement" type="button" data-time={chapter.time} aria-label={`从 ${chapter.stamp} 播放：${chapter.title}`}>
              <span class="movement-time">{chapter.stamp} <span aria-hidden="true">↗</span></span>
              <span><strong>{chapter.title}</strong><span class="movement-note">{chapter.note}</span></span>
            </button>
          ))}
        </div>
        <p class="stage-credit">画面、配乐、音效与剪辑全部由代码生成。<br />旁白：MiniMax speech-2.8-hd · doc_commentary<br /><strong>创作：DeepSeek Flash</strong></p>
      </aside>
    </section>

    <section class="film-note" aria-labelledby="film-note-title">
      <h2 id="film-note-title">关于这部短片</h2>
      <p>人类先看见电，很久以后才理解电。公元前六百年，希腊人只知道摩擦过的琥珀能吸起羽毛；1752 年，富兰克林把风筝放进雷雨；1800 年，伏打让稳定的电流第一次持续流动；1820 年，奥斯特发现电流会转动磁针；十一年后，法拉第反过来发现，变化的磁场也能生出电流。此后，发电机、变压器与电网才真正把电变成可以传输的公共能量。</p>
      <p>短片把这条认知链拆成七个场景，并在每个场景里留一个可读的科学原理：摩擦起电与电子转移、云地之间的电势差与空气击穿、化学能到电能的转换、电压与电流的水泵类比、电流的磁效应与电磁感应、交流升压与线路损耗。历史负责提供情绪，原理负责解释“为什么”。</p>
      <p>镜头也参与叙事：雷光过曝时完成时空跳转，钥匙火花切进云地放电剖面，铜片的圆环收束成奥斯特的导线，法拉第的线圈变成进入发电机内部的隧道，城市的灯光网络匹配芯片走线，最后从地球上的一个琥珀色光点回到片头的琥珀。硬切、遮幅与匹配剪辑都服务于同一个目标——让抽象的原理有一个可以被看见的入口。</p>
      <p class="credit">本片由 <strong>DeepSeek Flash</strong> 以编程方式创作。画面使用 Canvas 2D 场景、确定性时间轴与逐帧镜头变换；Puppeteer 驱动 Chromium 采集，ffmpeg 编码。配乐与音效由 numpy 合成；旁白由 MiniMax speech-2.8-hd / doc_commentary 生成（语速 0.96）。画面与声音均为原创程序化素材，没有使用外部影像或音乐采样。</p>
      <figure class="storyboard">
        <img src={storyboard} alt="电 · 从琥珀到星火八个章节的画面总览" />
        <figcaption>从暴风雨到夜地球：八个章节的画面总览。</figcaption>
      </figure>
      <div class="film-resources">
        <a href={mp4} download="电·从琥珀到星火.mp4">下载轻量版 MP4（8.9 MB）↓</a>
        <a href="/films/electricity/captions-zh.srt" download>下载中文字幕 ↓</a>
        <a href="/films/electricity/storyboard.webp" target="_blank" rel="noopener">查看章节总览 ↗</a>
        <a href="/films/electricity/credits.md" download>制作署名与技术说明 ↓</a>
      </div>
      <a class="button" href="/works/">返回作品馆 →</a>
    </section>
  </main>
</BaseLayout>

<script>
  import Hls from 'hls.js';
  const player = document.querySelector<HTMLVideoElement>('#electricity-player');
  const errorMessage = document.querySelector<HTMLElement>('#playback-error');
  if (player) {
    const source = player.dataset.source!;
    const showError = () => { if (errorMessage) errorMessage.hidden = false; };
    let hls: Hls | null = null;
    if (player.canPlayType('application/vnd.apple.mpegurl')) {
      player.src = source;
    } else if (Hls.isSupported()) {
      hls = new Hls({ maxBufferLength: 18, backBufferLength: 20 });
      hls.loadSource(source);
      hls.attachMedia(player);
      let retries = 0;
      hls.on(Hls.Events.ERROR, (_event, data) => {
        if (!data.fatal) return;
        if (data.type === Hls.ErrorTypes.NETWORK_ERROR && retries++ < 2) hls?.startLoad();
        else if (data.type === Hls.ErrorTypes.MEDIA_ERROR && retries++ < 2) hls?.recoverMediaError();
        else showError();
      });
    } else showError();
    const seek = (time: number) => {
      player.currentTime = time;
      player.play().catch(() => player.focus());
    };
    let pendingSeek: number | null = null;
    player.addEventListener('loadedmetadata', () => {
      if (pendingSeek !== null) { seek(pendingSeek); pendingSeek = null; }
    });
    document.querySelectorAll<HTMLButtonElement>('.movement').forEach((button) => {
      button.addEventListener('click', () => {
        const time = Number(button.dataset.time);
        if (player.readyState >= 1) seek(time);
        else { pendingSeek = time; if (!hls) player.load(); }
        player.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
      });
    });
    player.addEventListener('error', showError);
    player.addEventListener('playing', () => { if (errorMessage) errorMessage.hidden = true; });
    window.addEventListener('pagehide', () => hls?.destroy(), { once: true });
  }
</script>

<style>
  .film-page { padding-bottom: 70px; }
  .film-en { margin: -6px 0 22px; color: var(--ink-3); font-family: var(--mono); font-size: .74rem; letter-spacing: .24em; }
  .film-meta { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 24px; color: var(--ink-3); font-size: .8rem; letter-spacing: .04em; }
  .vertical-stage { display: grid; grid-template-columns: minmax(0, 430px) minmax(0, 1fr); gap: clamp(32px, 6vw, 74px); align-items: start; margin-top: 10px; padding: 34px 0 44px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .screen-column { min-width: 0; }
  .phone { border: 1px solid var(--line-strong); background: #05070c; padding: 10px 10px 11px; box-shadow: var(--shadow-lift); }
  .phone-bar { display: flex; justify-content: space-between; gap: 12px; padding: 1px 3px 10px; color: #a58f6d; font-family: var(--mono); font-size: 9px; letter-spacing: .12em; }
  .phone video { width: 100%; aspect-ratio: 9 / 16; display: block; background: #05070c; }
  .screening-caption { display: flex; justify-content: space-between; gap: 14px; padding-top: 12px; color: var(--ink-3); font-size: .78rem; }
  .screening-caption a { color: var(--amber); text-underline-offset: 4px; }
  .playback-error { padding-top: 10px; color: var(--amber); font-size: .8rem; }
  .playback-error a { color: var(--amber); text-underline-offset: 4px; }
  .stage-aside { padding-top: 3px; }
  .stage-aside h2 { margin: 13px 0 16px; font-family: var(--serif); font-size: clamp(1.65rem, 3vw, 2.15rem); line-height: 1.3; }
  .stage-intro { max-width: 530px; color: var(--ink-2); font-size: .92rem; line-height: 1.95; }
  .movement-list { margin-top: 26px; border-top: 1px solid var(--line); }
  .movement { width: 100%; display: grid; grid-template-columns: 62px minmax(0, 1fr); gap: 10px; padding: 14px 2px; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--ink); text-align: left; font: inherit; cursor: pointer; transition: color .16s ease, padding-left .16s ease; }
  .movement:hover { color: var(--amber); padding-left: 6px; }
  .movement:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
  .movement-time { padding-top: 3px; color: var(--ink-3); font-family: var(--mono); font-size: .7rem; letter-spacing: .02em; }
  .movement strong { display: block; font-family: var(--serif); font-size: 1.03rem; line-height: 1.35; }
  .movement-note { display: block; margin-top: 4px; color: var(--ink-3); font-size: .8rem; line-height: 1.65; }
  .stage-credit { margin-top: 24px; padding: 15px 16px; border: 1px solid var(--line); background: var(--amber-faint); color: var(--ink-3); font-size: .8rem; line-height: 1.85; }
  .stage-credit strong { color: var(--amber); font-weight: 600; }
  .film-note { max-width: 780px; margin-top: 56px; }
  .film-note h2 { font-family: var(--serif); font-size: 1.35rem; }
  .film-note p { line-height: 1.95; color: var(--ink-2); }
  .film-note .credit { font-size: .84rem; color: var(--ink-3); margin: 20px 0 26px; }
  .film-note .credit strong { color: var(--amber); }
  .storyboard { margin: 28px 0 28px; padding: 10px; border: 1px solid var(--line); background: var(--card); }
  .storyboard img { width: 100%; display: block; }
  .storyboard figcaption { padding-top: 9px; color: var(--ink-3); font-size: .74rem; }
  .film-resources { display: flex; flex-wrap: wrap; gap: 14px 24px; margin: 22px 0 32px; font-size: .86rem; }
  .film-resources a { color: var(--amber); text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .vertical-stage { grid-template-columns: minmax(0, 1fr); gap: 34px; }
    .phone { max-width: 430px; margin: 0 auto; }
    .screening-caption { max-width: 430px; margin: 0 auto; }
    .playback-error { max-width: 430px; margin: 0 auto; }
  }
  @media (max-width: 600px) {
    .storyboard { display: none; }
  }
  @media (max-width: 480px) {
    .phone { padding: 7px 7px 8px; }
    .phone-bar { padding: 1px 2px 7px; font-size: 8px; }
    .movement { grid-template-columns: 54px minmax(0, 1fr); padding: 12px 0; }
    .stage-credit { padding: 13px; }
    .film-note { margin-top: 40px; }
  }
</style>
