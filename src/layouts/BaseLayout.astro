---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title = site.title,
  description = site.description,
  current = '',
} = Astro.props;

const nav = [
  { label: '首页', href: '/', key: 'home' },
  { label: '作品', href: '/works/', key: 'works' },
  { label: '手记', href: '/notes/', key: 'notes' },
  { label: '关于', href: '/about/', key: 'about' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f1e5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site.url}/assets/og/brand.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="劳伦斯实验室 · 手记 RSS" href="/feed.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%23f6f1e5'/%3E%3Crect x='14' y='14' width='72' height='72' rx='12' fill='none' stroke='%23b4551e' stroke-width='6'/%3E%3Crect x='22' y='22' width='56' height='56' rx='8' fill='none' stroke='%23b4551e' stroke-width='2' opacity='.5'/%3E%3Ctext x='50' y='61' font-family='serif' font-size='29' font-weight='700' fill='%23b4551e' text-anchor='middle'%3E%E6%95%B0%E5%AD%97%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div id="paper-intro" class="paper-intro" aria-hidden="true">
      <canvas id="intro-cv"></canvas>
      <div class="intro-center">
        <div class="intro-stack" id="intro-stack">
          <div class="intro-title-row">
            <div class="intro-title" id="intro-title"><div class="t-row"><span>劳</span><span>伦</span><span>斯</span></div><div class="t-row t-row2"><span class="accent">实</span><span class="accent">验</span><span class="accent">室</span></div></div>
          </div>
          <div class="intro-kw" id="intro-kw"><span>数字</span><i>·</i><span>AI</span><i>·</i><span>探索</span></div>
          <div class="intro-cap" id="intro-cap">DIGITAL · AI · EXPLORATION · EST. 2026</div>
          <div class="intro-uline" id="intro-ul"></div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById('paper-intro');
        if (!el) return;
        var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var force = /(?:\?|&)intro=1(?:&|$)/.test(location.search); // ?intro=1 强制重播，便于预览
        if (reduced || (!force && sessionStorage.getItem('paperIntroSeen'))) { el.remove(); return; }
        sessionStorage.setItem('paperIntroSeen', '1');
        document.body.classList.add('intro-hold');

        var cv = document.getElementById('intro-cv');
        var ctx = cv && cv.getContext('2d');
        var kw = document.getElementById('intro-kw');
        var cap = document.getElementById('intro-cap');
        var ul = document.getElementById('intro-ul');
        var stack = document.getElementById('intro-stack');
        var center = document.querySelector('.intro-center');
        var accSpans = document.querySelectorAll('#intro-title .accent');
        var introSpans = document.querySelectorAll('#intro-title span');
        if (!ctx || !stack || !accSpans.length) {
          document.body.classList.remove('intro-hold');
          el.remove();
          return;
        }

        /* 万墨归字：0/1 墨粒在纸上漂散，被吸拢凝成主标，最后散作星尘 */
        var TITLE_FONT = '"MaShanZheng","Noto Serif SC","Songti SC","STSong","SimSun",serif';
        var MONO = '"SF Mono","Cascadia Code","JetBrains Mono",Consolas,"PingFang SC",monospace';
        var INK = '#26221a', AMBER = '#b4551e', AMBER2 = '#d98a3d';
        var CHARS = [
          { ch: '劳', amber: false }, { ch: '伦', amber: false }, { ch: '斯', amber: false },
          { ch: '实', amber: true }, { ch: '验', amber: true }, { ch: '室', amber: true }
        ];
        // 时间轴（秒，按模拟时间推进）：墨雾漂移 → 逐字凝聚分色 → 主题词收拢 → 定格 → 散作星尘
        var T_DRIFT = 0.4, T_KW = 1.9, T_UL = 2.15, T_CAP = 2.4, T_DIS = 3.6, T_END = 4.35;

        var dpr = Math.min(2, window.devicePixelRatio || 1);
        var vw = 0, vh = 0, fs = 0, anchored = false;
        var targets = [], parts = [];
        var sprites = null;
        var t0 = 0, last = 0, simT = 0, raf = 0, ended = false, liftOn = false;
        var kwOn = false, capOn = false, ulOn = false;
        var ptr = { x: -1e4, y: -1e4 };

        function rnd(a, b) { return a + Math.random() * (b - a); }

        function layout() {
          vw = innerWidth; vh = innerHeight;
          cv.width = Math.round(vw * dpr); cv.height = Math.round(vh * dpr);
          cv.style.width = vw + 'px'; cv.style.height = vh + 'px';
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          // 粒子直接聚合到首页主标题的位置（有 hero 时锚定其版面，无则视口居中）
          var anchor = document.querySelector('.hero-title');
          if (anchor) {
            anchored = true;
            fs = parseFloat(getComputedStyle(anchor).fontSize) || 48;
            var hr = anchor.getBoundingClientRect();
            center.style.position = 'fixed';
            center.style.left = hr.left + 'px';
            center.style.top = hr.top + 'px';
            center.style.placeItems = 'start';
            stack.style.justifyItems = 'start';
          } else {
            anchored = false;
            var rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
            fs = Math.min(Math.max(3.2 * rem, vw * 0.095), 6.8 * rem, vh * 0.17);
            center.style.position = '';
            center.style.left = '';
            center.style.top = '';
            center.style.placeItems = 'center';
            stack.style.justifyItems = 'center';
          }
          stack.style.fontSize = fs + 'px';
          // 隐形 DOM 主标只负责排版：量出「实验室」笔触下划线位置
          var lastAcc = accSpans[accSpans.length - 1].getBoundingClientRect();
          var firstAcc = accSpans[0].getBoundingClientRect();
          var srect = stack.getBoundingClientRect();
          ul.style.left = (firstAcc.left - srect.left) + 'px';
          ul.style.top = (firstAcc.bottom - srect.top + fs * 0.035) + 'px';
          ul.style.width = (lastAcc.right - firstAcc.left) + 'px';
        }

        function makeSprites() {
          var g1 = Math.max(8, fs * 0.085), g2 = g1 * 0.62, dot = Math.max(3.2, fs * 0.045);
          function mk(txt, size, color, isDot) {
            var c = document.createElement('canvas');
            var s = Math.ceil(size) + 4;
            c.width = c.height = Math.ceil(s * dpr);
            var x = c.getContext('2d');
            x.scale(dpr, dpr);
            x.fillStyle = color;
            if (isDot) {
              x.beginPath(); x.arc(s / 2, s / 2, size * 0.42, 0, 7); x.fill();
            } else {
              x.font = '600 ' + size + 'px ' + MONO;
              x.textAlign = 'center'; x.textBaseline = 'middle';
              x.fillText(txt, s / 2, s / 2 + size * 0.05);
            }
            return { c: c, w: s, h: s };
          }
          sprites = {
            ink: [mk('0', g1, INK), mk('1', g1, INK), mk('0', g2, INK), mk('1', g2, INK), mk('', dot, INK, true)],
            amber: [mk('0', g1, AMBER), mk('1', g1, AMBER), mk('0', g2, AMBER), mk('1', g2, AMBER), mk('', dot, AMBER, true), mk('0', g2, AMBER2), mk('', dot * 1.15, AMBER2, true)]
          };
        }

        function sampleTargets() {
          var budget = Math.round(Math.min(7000, Math.max(2400, (vw * vh) / 165)));
          var S = 2; // 超采样绘制，提高采样精度
          var oc = document.createElement('canvas');
          var ox = oc.getContext('2d', { willReadFrequently: true });
          ox.font = '400 ' + fs * S + 'px ' + TITLE_FONT;
          var m = ox.measureText('劳');
          var asc = m.actualBoundingBoxAscent || fs * S * 0.88;
          var desc = m.actualBoundingBoxDescent || fs * S * 0.12;
          // 字形目标直接取自隐形 DOM 主标的逐字 span 版面 → 与 hero 主标像素级重合
          // 两行错开排版：基线须逐字计算（第二行的 span 在另一条基线上）
          var lineHDef = fs * 1.06;
          // 步长按粒子预算自适应：字大机器好 → 粒子更多更密
          var step = 2 * fs * Math.sqrt((0.30 * CHARS.length) / budget);
          step = Math.max(2.4, Math.min(7, step)) * S;
          var pts = [];
          CHARS.forEach(function (c, i) {
            var r = introSpans[i].getBoundingClientRect();
            var lineH = r.height || lineHDef;
            var baseline = r.top + (lineH - (asc + desc) / S) / 2 + asc / S;
            oc.width = Math.ceil(r.width * S + 8); oc.height = Math.ceil(asc + desc + 8);
            ox.font = '400 ' + fs * S + 'px ' + TITLE_FONT; ox.textBaseline = 'alphabetic'; ox.fillStyle = '#000';
            ox.fillText(c.ch, 4, asc + 4);
            var data = ox.getImageData(0, 0, oc.width, oc.height).data;
            for (var y = 0; y < oc.height; y += step) {
              for (var x = 0; x < oc.width; x += step) {
                if (data[((y | 0) * oc.width + (x | 0)) * 4 + 3] > 120) {
                  pts.push({ x: r.left + x / S - 4 / S, y: baseline + (y - asc - 4) / S + rnd(-0.6, 0.6), amber: c.amber, ci: i });
                }
              }
            }
          });
          if (!pts.length) { pts = [{ x: vw / 2, y: vh / 2, amber: false, ci: 0 }]; }
          // 打乱后按预算取用/补足
          for (var i = pts.length - 1; i > 0; i--) { var j = (Math.random() * (i + 1)) | 0; var tmp = pts[i]; pts[i] = pts[j]; pts[j] = tmp; }
          targets = [];
          for (var k = 0; k < budget; k++) {
            var p = pts[k % pts.length];
            targets.push({ x: p.x + (k >= pts.length ? rnd(-1.4, 1.4) : 0), y: p.y + (k >= pts.length ? rnd(-1.4, 1.4) : 0), amber: p.amber, ci: p.ci });
          }
        }

        function buildParts() {
          parts = targets.map(function (t) {
            var inBand = Math.random() < 0.62;
            return {
              tx: t.x, ty: t.y, amber: t.amber,
              x: inBand ? rnd(vw * 0.08, vw * 0.92) : rnd(-40, vw + 40),
              y: inBand ? rnd(vh * 0.18, vh * 0.74) : rnd(-40, vh + 40),
              vx: rnd(-12, 12), vy: rnd(-12, 12),
              delay: T_DRIFT + t.ci * 0.07 + rnd(0, 0.18),
              sprI: 0, j: rnd(0.85, 1.25), alpha: 0, seed: rnd(0, 100),
              dis: null
            };
          });
          for (var i = 0; i < parts.length; i++) {
            var p = parts[i];
            var arr = p.amber ? sprites.amber : sprites.ink;
            var r = Math.random();
            p.sprI = r < 0.34 ? 0 : r < 0.6 ? 1 : r < 0.74 ? 2 : r < 0.84 ? 3 : r < 0.94 ? 4 : (arr.length > 5 ? 5 + ((Math.random() * 2) | 0) : 4);
          }
        }

        function noiseAng(x, y, t) {
          return Math.sin(x * 0.0042 + t * 0.9) * 1.8
               + Math.cos(y * 0.0038 - t * 0.7) * 1.8
               + Math.sin((x + y) * 0.0016 + t * 0.35) * 1.2;
        }

        function tick(t, dt) {
          if (t >= T_KW && !kwOn) { kwOn = true; kw.classList.add('go'); }
          if (t >= T_UL && !ulOn) { ulOn = true; ul.classList.add('go'); }
          if (t >= T_CAP && !capOn) { capOn = true; cap.classList.add('go'); }

          for (var n = 0; n < parts.length; n++) {
            var p = parts[n];
            if (t < T_DIS) {
              if (t < p.delay) { // 墨雾漂移
                var a = noiseAng(p.x, p.y, t);
                p.vx += Math.cos(a) * 210 * dt; p.vy += (Math.sin(a) * 210 - 9) * dt;
                p.vx *= 0.93; p.vy *= 0.93;
                p.alpha = Math.min(0.5, p.alpha + dt * 0.75);
              } else { // 被吸向字模：速度转向（远处全速冲、近处指数缓收）
                var el2 = t - p.delay, ramp = Math.min(1, el2 / 0.3);
                var dx = p.tx - p.x, dy = p.ty - p.y;
                var d = Math.hypot(dx, dy) || 1;
                var want = Math.min(d * 8, 1600) * ramp;
                var steer = Math.min(1, 10 * dt);
                p.vx += ((dx / d) * want - p.vx) * steer;
                p.vy += ((dy / d) * want - p.vy) * steer;
                if (el2 < 0.3 && d > 12) { // 起飞阶段加一点旋度，路径呈卷流
                  p.vx += (-dy / d) * 340 * (1 - el2 / 0.3) * dt;
                  p.vy += (dx / d) * 340 * (1 - el2 / 0.3) * dt;
                }
                if (d < 1.6) { p.x = p.tx; p.y = p.ty; p.vx = p.vy = 0; }
                p.alpha = Math.min(0.92, p.alpha + dt * 3.2);
              }
              // 指针搅动
              var pdx = p.x - ptr.x, pdy = p.y - ptr.y, pr2 = pdx * pdx + pdy * pdy;
              if (pr2 < 12100 && pr2 > 0.01) {
                var pr = Math.sqrt(pr2), fo = (1 - pr / 110) * 1400;
                p.vx += (pdx / pr) * fo * dt; p.vy += (pdy / pr) * fo * dt;
              }
              p.x += p.vx * dt; p.y += p.vy * dt;
              // 落定后的微颤（墨粒仍活着）
              if (p.x === p.tx && t > p.delay + 0.8) { p.x += Math.sin(t * 21 + p.seed) * 0.32; }
            } else { // 散作星尘：缓缓上扬、渐次熄灭
              if (!p.dis) {
                var da = noiseAng(p.x, p.y, 7) + rnd(-0.5, 0.5);
                p.dis = { vx: Math.cos(da) * rnd(60, 260), vy: Math.sin(da) * rnd(60, 260) - rnd(30, 150) };
              }
              p.x += p.dis.vx * dt; p.y += p.dis.vy * dt;
              p.alpha = Math.max(0, p.alpha - dt * 2.2);
            }
          }
        }

        function draw(t) {
          var gA = t > T_DIS ? Math.max(0, 1 - (t - T_DIS) / 0.5) : 1;
          ctx.clearRect(0, 0, vw, vh);
          for (var n = 0; n < parts.length; n++) {
            var p = parts[n];
            if (p.alpha <= 0.01) continue;
            var spr = (p.amber ? sprites.amber : sprites.ink)[p.sprI];
            ctx.globalAlpha = p.alpha * gA;
            var w = spr.w * p.j, h = spr.h * p.j;
            ctx.drawImage(spr.c, p.x - w / 2, p.y - h / 2, w, h);
          }
          ctx.globalAlpha = 1;
        }

        function frame(now) {
          if (!t0) { t0 = now; last = now; }
          var dt = Math.min(0.05, Math.max(0.001, (now - last) / 1000));
          last = now;
          simT += dt; // 时间轴走模拟时间：后台节流只是慢放，不会跳过节拍
          tick(simT, dt);
          draw(simT);
          if (simT >= T_DIS + 0.15 && !liftOn) {
            liftOn = true;
            el.classList.add('lift');
            document.body.classList.remove('intro-hold');
          }
          if (simT < T_END) { raf = requestAnimationFrame(frame); }
          else {
            ended = true;
            cancelAnimationFrame(raf);
            removeEventListener('pointermove', onMove);
            setTimeout(function () { el.remove(); }, 650);
          }
        }

        // 从头重播（切回可见标签页 / 窗口尺寸变化时），保证各环节完整走完
        function restart(relayout) {
          if (ended) return;
          cancelAnimationFrame(raf);
          if (relayout) { layout(); makeSprites(); sampleTargets(); }
          else buildParts();
          simT = 0; kwOn = capOn = ulOn = liftOn = false;
          el.classList.remove('lift');
          document.body.classList.add('intro-hold');
          [kw, cap, ul].forEach(function (n) { n.classList.remove('go'); });
          void kw.offsetWidth;
          raf = requestAnimationFrame(frame);
        }

        function onMove(e) { ptr.x = e.clientX; ptr.y = e.clientY; }

        function init() {
          layout(); makeSprites(); sampleTargets(); buildParts();
          raf = requestAnimationFrame(frame);
        }

        addEventListener('pointermove', onMove, { passive: true });
        addEventListener('resize', function () {
          if (ended) return;
          clearTimeout(init._rt);
          init._rt = setTimeout(function () { restart(true); }, 180);
        });
        // 页面在后台/失焦加载时 RAF 被节流，切回可见的瞬间从第一拍完整重播
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden && !ended && !liftOn) restart(false);
        });
        // 等书法字体就绪再采样（1.6s 超时则回落系统衬线，视觉仍一致）
        var booted = false;
        function boot() {
          if (booted) return;
          booted = true;
          init();
        }
        if (document.fonts && document.fonts.load) {
          setTimeout(boot, 1600);
          document.fonts.load('400 32px MaShanZheng', '劳伦斯实验室').then(boot, boot);
        } else {
          boot();
        }
        // 兜底：任何原因导致动画走不完，12 秒后强制揭页
        setTimeout(function () {
          if (ended || !document.body.contains(el)) return;
          ended = true;
          cancelAnimationFrame(raf);
          document.body.classList.remove('intro-hold');
          el.remove();
        }, 12000);
      })();
    </script>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="劳伦斯实验室 首页">
        <span class="brand-copy">
          <strong>{site.name}</strong>
          <small><span class="kw-zh">数字 · AI · 探索</span><span class="kw-en">DIGITAL · AI · EXPLORATION</span></small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {nav.map((item) => (
          <a class:list={[current === item.key && 'active']} href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>劳伦斯实验室</strong>
        <p class="footer-kw"><span class="kw-zh">数字 · AI · 探索</span><span class="kw-en">DIGITAL · AI · EXPLORATION</span></p>
        <p>个人主站 · 数字作品 / 旅行实验室 / 手记</p>
        <p class="footer-beian">
          <a href={site.beian.icpLink} target="_blank" rel="noopener">{site.beian.icp}</a>
        </p>
      </div>
      <div class="footer-links">
        {site.social.map((item) => item.href ? (
          <a href={item.href} target="_blank" rel="noopener">{item.name}</a>
        ) : (
          <span>{item.name}</span>
        ))}
      </div>
    </footer>
  </body>
</html>
