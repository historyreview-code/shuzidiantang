---
import '../styles/global.css';
import { site, works } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const {
  title = site.title,
  description = site.description,
  current = '',
} = Astro.props;

// 开屏胶片带：馆藏卡片缩略图连续飞过（上下两条，反向）
const introFrames = [
  ...works.filter((w) => !w.footer).slice(0, 7).map((w) => w.image),
  '/assets/img/travel/uk-roadbook.webp',
  '/assets/img/travel/bili/skye.webp',
  '/assets/img/travel/bili/cambridge.webp',
];
const introFramesB = [...introFrames].reverse();

const nav = [
  { label: '首页', href: '/', key: 'home' },
  { label: '作品', href: '/works/', key: 'works' },
  { label: '手记', href: '/notes/', key: 'notes' },
  { label: '关于', href: '/about/', key: 'about' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f1e5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${site.url}/assets/og/brand.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="劳伦斯在上海 · 手记 RSS" href="/feed.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%23f6f1e5'/%3E%3Crect x='14' y='14' width='72' height='72' rx='12' fill='none' stroke='%23b4551e' stroke-width='6'/%3E%3Crect x='22' y='22' width='56' height='56' rx='8' fill='none' stroke='%23b4551e' stroke-width='2' opacity='.5'/%3E%3Ctext x='50' y='61' font-family='serif' font-size='29' font-weight='700' fill='%23b4551e' text-anchor='middle'%3E%E6%95%B0%E5%AD%97%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div id="paper-intro" class="paper-intro" aria-hidden="true">
      <div class="intro-digits" aria-hidden="true">
        <span>0101 0110 1001 0011</span>
        <span>1001 0101 1100 0101</span>
        <span>0011 1010 0101 1100</span>
        <span>1100 0110 0011 0101</span>
      </div>
      <div class="intro-film intro-film--top" aria-hidden="true">
        <div class="intro-film-track">{[...introFrames, ...introFrames].map((src) => <img src={src} alt="" />)}</div>
      </div>
      <div class="intro-film intro-film--bottom" aria-hidden="true">
        <div class="intro-film-track">{[...introFramesB, ...introFramesB].map((src) => <img src={src} alt="" />)}</div>
      </div>
      <div class="intro-center">
        <div class="intro-title-row">
          <div class="intro-title">
            <span>劳</span><span>伦</span><span>斯</span><span class="accent">在</span><span class="accent">上</span><span class="accent">海</span>
          </div>
          <div class="intro-stamp-wrap">
            <div class="intro-ring" aria-hidden="true"></div>
            <div class="stamp intro-stamp">数字</div>
          </div>
        </div>
        <div class="intro-ticker" aria-hidden="true">
          <div class="intro-ticker-inner">
            <span>SHUZIDIANTANG.COM · 劳伦斯在上海 · AI 浪潮 ·&nbsp;</span>
            <span>SHUZIDIANTANG.COM · 劳伦斯在上海 · AI 浪潮 ·&nbsp;</span>
          </div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById('paper-intro');
        if (!el) return;
        var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || sessionStorage.getItem('paperIntroSeen')) {
          el.remove();
          return;
        }
        sessionStorage.setItem('paperIntroSeen', '1');
        el.classList.add('play');
        el.addEventListener('animationend', function (e) {
          if (e.target === el) el.remove();
        });
        setTimeout(function () { el.remove(); }, 3400);
      })();
    </script>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="劳伦斯在上海 首页">
        <span class="brand-mark" aria-hidden="true">数字</span>
        <span class="brand-copy">
          <strong>{site.name}</strong>
          <small>Shuzidiantang.com · Est. 2026</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {nav.map((item) => (
          <a class:list={[current === item.key && 'active']} href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>劳伦斯在上海</strong>
        <p>个人主站 · 数字作品 / 旅行实验室 / 手记</p>
        <p class="footer-beian">
          <a href={site.beian.icpLink} target="_blank" rel="noopener">{site.beian.icp}</a>
        </p>
      </div>
      <div class="footer-links">
        {site.social.map((item) => item.href ? (
          <a href={item.href} target="_blank" rel="noopener">{item.name}</a>
        ) : (
          <span>{item.name}</span>
        ))}
      </div>
    </footer>
  </body>
</html>
