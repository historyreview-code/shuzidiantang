---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  current = '',
  image = '/assets/og/brand.png',
} = Astro.props;

const nav = [
  { label: '首页', href: '/', key: 'home' },
  { label: '作品', href: '/works/', key: 'works' },
  { label: '理论研究', href: '/research/', key: 'research' },
  { label: '手记', href: '/notes/', key: 'notes' },
  { label: '关于', href: '/about/', key: 'about' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f1e5" />
    <link rel="preload" href="/assets/fonts/mashanzheng-title.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="劳伦斯实验室 · 手记 RSS" href="/feed.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='16' fill='%23f6f1e5'/%3E%3Crect x='14' y='14' width='72' height='72' rx='12' fill='none' stroke='%23b4551e' stroke-width='6'/%3E%3Crect x='22' y='22' width='56' height='56' rx='8' fill='none' stroke='%23b4551e' stroke-width='2' opacity='.5'/%3E%3Ctext x='50' y='66' font-family='serif' font-size='42' font-weight='700' fill='%23b4551e' text-anchor='middle'%3E%E5%8A%B3%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <div id="paper-intro" class="paper-intro" hidden>
      <canvas id="intro-cv" aria-hidden="true"></canvas>
      <div class="intro-masthead" aria-hidden="true"><span>LAWRENCE LAB</span><span class="intro-edition">A FIELD OF POSSIBILITIES / 2026</span></div>
      <div class="intro-caption" aria-hidden="true"><span>HUMAN CURIOSITY × ARTIFICIAL INTELLIGENCE</span><p>一念，连接万千可能。</p></div>
      <div class="intro-title-card" aria-hidden="true">
        <span class="intro-eyebrow">由好奇心驱动 · 与 AI 共创</span>
        <p class="intro-wordmark"><span>劳伦斯</span><span>实验室</span></p>
        <span class="intro-rule"></span>
        <p class="intro-tagline">数字 · AI · 探索</p>
        <span class="intro-domain">SHUZIDIANTANG.COM</span>
      </div>
      <div class="intro-bottom"><span class="intro-phase" aria-hidden="true">01 / 灵感点亮</span><button class="intro-skip" type="button">跳过片头 <span aria-hidden="true">↗</span></button></div>
      <div class="intro-progress" aria-hidden="true"><span></span></div>
    </div>
    <script is:inline>
      (function () {
        /* 5.8 秒片头；?intro=1 重播，?freeze=秒 定帧。无脚本时直接显示网站。 */
        var el = document.getElementById('paper-intro');
        if (!el) return;
        var reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var qs = new URLSearchParams(location.search);
        var rawFreeze = qs.has('freeze') ? Number(qs.get('freeze')) : NaN;
        var FREEZE = Number.isFinite(rawFreeze) ? Math.max(0, Math.min(5.79, rawFreeze)) : null;
        var force = /(?:\?|&)intro=1(?:&|$)/.test(location.search) || FREEZE != null;
        var seen = false;
        try { seen = sessionStorage.getItem('paperIntroSeen') === '1'; } catch (_) {}
        if (reduced || (!force && seen)) { el.remove(); return; }
        var cv = document.getElementById('intro-cv');
        if (!(cv && cv.getContext('2d'))) { el.remove(); return; }
        try { sessionStorage.setItem('paperIntroSeen', '1'); } catch (_) {}
        el.hidden = false;
        document.body.classList.add('intro-hold');
        window.__INTRO_OPTS = { freeze: FREEZE };
        var watchdog;
        window.__INTRO_ENDED = false;
        function bail(lift) {
          if (window.__INTRO_ENDED) return;
          window.__INTRO_ENDED = true;
          clearTimeout(watchdog);
          if (window.__INTRO_CLEANUP) window.__INTRO_CLEANUP();
          document.body.classList.remove('intro-hold');
          if (!el.parentNode) return;
          if (el.contains(document.activeElement)) document.activeElement.blur();
          if (lift) { el.classList.add('lift'); setTimeout(function () { if (el.parentNode) el.remove(); }, 450); }
          else el.remove();
        }
        window.__INTRO_FINISH = bail;
        if (FREEZE == null) watchdog = setTimeout(function () { bail(true); }, 7500);
        var s = document.createElement('script');
        s.src = '/intro.js?v=20260928';
        s.onerror = function () { bail(false); };
        document.head.appendChild(s);
      })();
    </script>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="劳伦斯实验室 首页">
        <span class="brand-copy">
          <strong>{site.name}</strong>
          <small><span class="kw-zh">数字 · AI · 探索</span><span class="kw-en">DIGITAL · AI · EXPLORATION</span></small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {nav.map((item) => (
          <a class:list={[current === item.key && 'active']} href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>劳伦斯实验室</strong>
        <p class="footer-kw"><span class="kw-zh">数字 · AI · 探索</span><span class="kw-en">DIGITAL · AI · EXPLORATION</span></p>
        <p>个人主站 · 数字作品 / 理论研究 / 旅行实验室 / 手记</p>
        <p class="footer-beian">
          <a href={site.beian.icpLink} target="_blank" rel="noopener">{site.beian.icp}</a>
          <a href={site.beian.gonganLink} target="_blank" rel="noopener noreferrer">{site.beian.gongan}</a>
        </p>
      </div>
      <div class="footer-links">
        {site.social.map((item) => item.href ? (
          <a href={item.href} target="_blank" rel="noopener">{item.name}</a>
        ) : (
          <span>{item.name}</span>
        ))}
      </div>
    </footer>
  </body>
</html>
