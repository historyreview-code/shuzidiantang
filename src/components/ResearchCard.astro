---
import { research } from '../data/research';
const { report = research[0] } = Astro.props;
---
<article class="research-card">
  <div class="research-cover" aria-hidden="true">
    <span class="cover-label">理论研究 / 001</span>
    <strong>土地续期<br /><em>与补地价</em></strong>
    <div class="cover-divider"></div>
    <span class="cover-caption">权利 · 年期 · 价值</span>
  </div>
  <div class="research-copy">
    <span class="kicker">专题报告 · {report.date}</span>
    <h3><a href={report.href}>{report.title}</a></h3>
    <p class="research-subtitle">{report.subtitle}</p>
    <p>{report.summary}</p>
    <div class="tag-list">{report.tags.map(tag => <span>{tag}</span>)}</div>
    <p class="research-meta">资料截至 {report.evidenceDate} · {report.sources} 条来源 · {report.pages} 页 PDF</p>
    <div class="research-actions">
      <a class="button" href={report.href}>阅读报告 <span aria-hidden="true">→</span></a>
      <a class="research-download" href={report.pdf} download>下载 PDF <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</article>
<style>
  .research-card{display:grid;grid-template-columns:minmax(240px,.78fr) minmax(0,1.5fr);gap:40px;padding:30px;border:1px solid var(--line);background:var(--card);border-radius:5px}
  .research-cover{background:#e9eee5;color:#294e43;min-height:305px;padding:30px;display:flex;flex-direction:column;justify-content:center;position:relative;border:1px solid #cad7c8}
  .cover-label{font:11px var(--mono);letter-spacing:.1em;margin-bottom:26px;color:#62796c}
  .research-cover strong{font:500 clamp(32px,3.1vw,44px)/1.55 var(--serif);letter-spacing:.04em}.research-cover em{font-style:normal;color:#537862}.cover-divider{width:40px;height:2px;background:#b09663;margin:25px 0 15px}.cover-caption{font:12px var(--serif);letter-spacing:.25em}
  .research-copy{align-self:center;min-width:0}.research-copy h3{font:600 clamp(24px,2.4vw,32px)/1.5 var(--serif);margin:12px 0 8px}.research-copy h3 a{text-decoration:none}.research-copy p{font-size:14px;line-height:1.95;color:var(--ink-2);margin:10px 0 18px}.research-copy .research-subtitle{font-size:16px;color:var(--ink-2);margin-bottom:12px}.research-copy .research-meta{font-size:11px;color:var(--ink-3);margin:20px 0 14px}.research-actions{display:flex;gap:25px;align-items:center;flex-wrap:wrap}.research-download{font-size:13px;text-underline-offset:5px}
  @media(max-width:720px){.research-card{grid-template-columns:1fr;padding:18px;gap:24px}.research-cover{min-height:230px;padding:25px}.research-cover strong{font-size:34px}.cover-label{margin-bottom:14px}.cover-divider{margin-top:15px}.research-copy h3{font-size:25px}}
</style>
