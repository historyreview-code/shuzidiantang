---
import { travelSeries } from '../data/site';

const mainItems = travelSeries.slice(0, 3);
const destItems = travelSeries.slice(3);
const groupLabel = destItems[0]?.groupLabel;
---
<div class="series-block">
  <div class="series-head">
    <span class="kicker">旅行 · Travel</span>
    <h3>旅行实验室</h3>
    <p>目的地历史文化手绘介绍 → 路线确定生成路书（旅途助手）→ 过程生成小红书卡片 → 视频记录短片：一切都智能高效，富有知识向与审美标准。
      <a class="github-badge" href="https://www.bilibili.com/video/BV1gH4k63EUm" target="_blank" rel="noopener">▶ B站演示 ↗</a>
      <a class="github-badge" href="https://github.com/historyreview-code/shuzidiantang/tree/main/travel-console" target="_blank" rel="noopener">⌥ 开源代码 ↗</a>
      <a class="series-index-link" href="/travel/">目录 ↗</a>
    </p>
  </div>
  <div class="series-grid">
    {mainItems.map((item) => (
      item.href ? (
        <article class="series-card">
          <a class="card-link" href={item.href} aria-label={`${item.title}，进入作品`} {...item.external ? { target: '_blank', rel: 'noopener' } : {}}></a>
          {item.img ? (
            <div class="series-frame"><img src={item.img} alt={`${item.title}预览`} loading="lazy" /></div>
          ) : (
            <div class="series-frame series-frame-empty" aria-hidden="true"><span class="stamp">旅</span></div>
          )}
          <div class="series-body">
            <span class="meta">{item.meta || (item.external ? '外部' : '站内')}</span>
            <h4>{item.title}</h4>
            <small>{item.sub}</small>
            {item.github && <a class="github-badge" href={item.github} target="_blank" rel="noopener">⌥ 开源代码 ↗</a>}
          </div>
        </article>
      ) : (
        <article class="series-card series-card-pending" aria-label={`${item.title}，打磨中`}>
          <div class="series-frame series-frame-empty" aria-hidden="true"><span class="stamp">打磨中</span></div>
          <div class="series-body">
            <span class="meta">占位</span>
            <h4>{item.title}</h4>
            <small>{item.sub}</small>
          </div>
        </article>
      )
    ))}
  </div>

  {groupLabel && <div class="series-group-head"><span>{groupLabel}</span></div>}
  <div class="series-grid series-grid--small">
    {destItems.map((item) => (
      item.href ? (
        <article class="series-card series-card--small">
          <a class="card-link" href={item.href} aria-label={`${item.title}，观看视频`} {...item.external ? { target: '_blank', rel: 'noopener' } : {}}></a>
          <div class="series-frame"><img src={item.img} alt={`${item.title}预览`} loading="lazy" /></div>
          <div class="series-body">
            <span class="meta">{item.meta || 'B站'}</span>
            <h4>{item.title}</h4>
            <small>{item.sub}</small>
          </div>
        </article>
      ) : (
        <article class="series-card series-card--small series-card-pending" aria-label={`${item.title}，打磨中`}>
          <div class="series-frame series-frame-empty" aria-hidden="true"><span class="stamp">打磨中</span></div>
          <div class="series-body">
            <span class="meta">占位</span>
            <h4>{item.title}</h4>
            <small>{item.sub}</small>
          </div>
        </article>
      )
    ))}
  </div>
</div>
