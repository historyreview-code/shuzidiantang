---
import Icon from './DirectoryIcon.astro';
import DirectoryCard from './DirectoryCard.astro';
import { catalog, catalogCount, featuredItems } from '../data/catalog';
import '../styles/directory.css';
interface Props { worksPage?: boolean; }
const { worksPage = false } = Astro.props;
---
<main id="content" class="directory-page-content">
  <section class:list={['directory-hero', worksPage && 'directory-hero--small']} id="top">
    <div class="directory-intro">
      <p class="directory-eyebrow"><span></span> LAWRENCE LAB / COLLECTION</p>
      <h1>{worksPage ? <>作品与探索<span>从兴趣出发。</span></> : <>好奇心，<span>有很多入口。</span></>}</h1>
      <p class="directory-lead">{worksPage ? '数字作品与游戏、视频与播客、研究电子书、城市悠游与手记。所有内容按类别收在这里。' : '数字作品与游戏、本站视频与播客、专题研究电子书，还有城市悠游和手记。随意逛逛，找到下一件想探索的事。'}</p>
      <div class="directory-intro-foot"><span>{String(catalog.length).padStart(2, '0')} 个分类<span class="intro-dot">·</span>{catalogCount} 个探索入口</span><a href="#directory">向下探索 <span aria-hidden="true">↓</span></a></div>
    </div>
    {!worksPage && <div class="directory-feature" data-feature-carousel role="group" aria-roledescription="推送轮播" aria-label="首屏滚动推送">
      <div class="feature-track">
        {featuredItems.map((item, index) => <a class:list={['feature-slide', index === 0 && 'is-active']} href={item.href} data-slide id={`feature-panel-${index}`} role="tabpanel" aria-labelledby={`feature-tab-${index}`} aria-hidden={index === 0 ? undefined : 'true'} tabindex={index === 0 ? undefined : -1}>
          <div class="feature-image">
            <img src={item.image} alt={`${item.title}封面`} width="720" height="405" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} />
            <span class="feature-label"><Icon name={item.icon} size={15} /> {item.meta}</span>
            <span class="feature-play"><Icon name="arrow" size={21} /></span>
          </div>
          <div class="feature-caption"><span>{item.summary}</span><strong>{item.title}</strong><span>{item.note}</span></div>
        </a>)}
      </div>
      <div class="feature-dots" role="tablist" aria-label="选择推送内容">
        {featuredItems.map((item, index) => <button type="button" role="tab" data-dot={index} id={`feature-tab-${index}`} aria-controls={`feature-panel-${index}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} aria-label={`第 ${index + 1} 项：${item.title}`}></button>)}
      </div>
    </div>}
  </section>
  <nav class="directory-nav" id="directory" aria-label="内容分类" style={`--category-columns: ${catalog.length}`}>
    {catalog.map((group, index) => <a href={`#${group.id}`} data-category={group.id} class:list={['category-link', `tone-${group.color}`, index === 0 && 'is-active']} aria-current={index === 0 ? 'location' : undefined}>
      <span class="category-icon"><Icon name={group.icon} size={22} /></span><span class="category-name">{group.navLabel || group.title}</span><span class="category-count">{String(group.items.length + (group.related?.length || 0)).padStart(2, '0')}</span>
    </a>)}
  </nav>
  <div class="directory-sections">
    {catalog.map((group, index) => <section class:list={['directory-section', `tone-${group.color}`]} id={group.id} aria-labelledby={`${group.id}-title`}>
      <header class="directory-section-head">
        <div class="section-heading"><span class="section-symbol"><Icon name={group.icon} size={25} /></span><div><span class="section-index">{String(index + 1).padStart(2, '0')} / {group.english}</span><h2 id={`${group.id}-title`}>{group.title}</h2></div></div>
        <div class="section-description"><p>{group.description}</p>{group.more && <a href={group.more.href}>{group.more.label} <Icon name="arrow" size={15} /></a>}</div>
      </header>
      {group.layout === 'entry'
        ? <div class="directory-entry">{group.items.map(item => <a class="entry-card" href={item.href}>
            {item.image && <div class="entry-cover"><img src={item.image} alt={`${item.title}封面`} width="1200" height="750" loading="lazy" decoding="async" /></div>}
            <div class="entry-copy">
              <div class="directory-card-meta"><span class="entry-icon"><Icon name={item.icon} size={16} /></span><span>{item.meta}</span></div>
              <h3>{item.title}</h3><p>{item.summary}</p>
              <span class="entry-cta">{group.more?.label || '进入'} <Icon name="arrow" size={16} /></span>
            </div>
          </a>)}</div>
        : <div class:list={['directory-grid', group.id === 'notes' && 'directory-grid--notes']}>{group.items.map(item => <DirectoryCard item={item} />)}</div>}
      {group.related && <div class="directory-related"><h3 class="related-heading"><span>{group.relatedTitle}</span><span>{group.related.length} 部作品</span></h3><div class="directory-grid directory-grid--compact">{group.related.map(item => <DirectoryCard item={item} compact />)}</div></div>}
    </section>)}
  </div>
  <div class="directory-end"><span>继续保持好奇。</span><a href="#top">回到顶部 <Icon name="up" size={17} /></a></div>
</main>
<script>
  // 原生锚点负责定位；脚本只同步当前分类和固定导航的真实高度。
  const header = document.querySelector<HTMLElement>('.site-header');
  const nav = document.querySelector<HTMLElement>('.directory-nav');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.directory-section'));
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-category]'));
  let queued = false;
  function updateCurrent() {
    queued = false;
    if (!nav) return;
    const offset = (header?.offsetHeight || 0) + nav.offsetHeight + 36;
    let active = sections[0]?.id;
    for (const section of sections) if (section.getBoundingClientRect().top <= offset) active = section.id;
    for (const link of links) {
      const current = link.dataset.category === active;
      link.classList.toggle('is-active', current);
      if (current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }
  function scheduleUpdate() { if (!queued) { queued = true; requestAnimationFrame(updateCurrent); } }
  function measure() {
    document.documentElement.style.setProperty('--directory-header-height', `${header?.offsetHeight || 74}px`);
    document.documentElement.style.setProperty('--directory-nav-height', `${nav?.offsetHeight || 78}px`);
    scheduleUpdate();
  }
  if (header && nav && 'ResizeObserver' in window) {
    const observer = new ResizeObserver(measure);
    observer.observe(header); observer.observe(nav);
  }
  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', measure, { passive: true });
  measure();

  // 首屏滚动推送：自动轮播 + 圆点切换；悬停/聚焦暂停，减少动效时不自动播放。
  const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
  for (const carousel of Array.from(document.querySelectorAll<HTMLElement>('[data-feature-carousel]'))) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    if (slides.length < 2) continue;
    let current = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('is-active', active);
        if (active) { slide.removeAttribute('aria-hidden'); slide.removeAttribute('tabindex'); }
        else { slide.setAttribute('aria-hidden', 'true'); slide.setAttribute('tabindex', '-1'); }
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-selected', i === current ? 'true' : 'false');
        dot.tabIndex = i === current ? 0 : -1;
      });
    };
    const stop = () => { if (timer !== undefined) { window.clearInterval(timer); timer = undefined; } };
    const start = () => { if (reducedMotion) return; stop(); timer = window.setInterval(() => show(current + 1), 6000); };
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
    carousel.querySelector('.feature-dots')?.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      event.preventDefault();
      const next = (current + step + slides.length) % slides.length;
      show(next); dots[next]?.focus(); start();
    });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    show(0);
    start();
  }
</script>
