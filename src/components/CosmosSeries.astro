---
import { cosmosSeries } from '../data/site';
---
<div class="series-block">
  <div class="series-head">
    <span class="kicker">天文与宇宙 · Cosmos</span>
    <h3>天文与宇宙 · 六部科普短片</h3>
    <p>六个天文主题，每集几分钟。对宇宙有兴趣的话，点开一集看看。</p>
  </div>
  <div class="series-grid">
    {cosmosSeries.map((ep) => (
      <a class="series-card" href={ep.href}>
        <div class="series-frame">
          <img src={ep.img} alt={`${ep.title}预览`} loading="lazy" />
        </div>
        <div class="series-body">
          <span class="meta">{ep.ep}</span>
          <h4>{ep.title}</h4>
          <small>{ep.sub}</small>
        </div>
      </a>
    ))}
  </div>
</div>
